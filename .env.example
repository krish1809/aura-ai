# Copy to .env and adjust. Every backend setting is AURA_<NAME> (see backend/src/aura_api/config.py).

# Required in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
AURA_JWT_SECRET=change-me
POSTGRES_PASSWORD=aura
# Set to true when serving over HTTPS
AURA_COOKIE_SECURE=false

# ML mode: lite = CPU only (rules + small sklearn models), full = trained GPU models
AURA_ML_MODE=lite
# Reply generation: mock | local (Llama 3.2 3B + Aura LoRA, needs ML_MODE=full) | openai (any OpenAI-compatible server, e.g. Ollama)
AURA_LLM_PROVIDER=mock
AURA_OPENAI_BASE_URL=http://localhost:11434/v1
AURA_OPENAI_MODEL=aura
# AURA_OPENAI_API_KEY=

# Local development uses SQLite by default:
# AURA_DATABASE_URL=sqlite+aiosqlite:///./aura.db
